name: "LevinPlayer"

platforms:

  common:
    context:
      flags : ["-O2", "-flto"]
      defines: [
                  "SUPPORT_FILEFORMAT_XM", 
                  "SUPPORT_FILEFORMAT_MOD",
                  "MA_NO_DSOUND",
                  "MA_NO_WINMM",
                  "MA_NO_ALSA",
                  "MA_NO_PULSEAUDIO",
                  "MA_NO_JACK",
                  "MA_NO_SNDIO",
                  "MA_NO_AUDIO4",
                  "MA_NO_OSS",
                  "MA_NO_AAUDIO",
                  "MA_NO_OPENSL"
                ]
  
  armv7-ios:
    context:
      excludeLibs: [physics, LinearMath, BulletDynamics, BulletCollision, Box2D, script_box2d]
      excludeSymbols: [ScriptBox2DExt]
      symbols: []
      libs: [physics_null]
      frameworks: []
      linkFlags: []
  arm64-ios:
    context:
      excludeLibs: [physics, LinearMath, BulletDynamics, BulletCollision, Box2D, script_box2d]
      excludeSymbols: [ScriptBox2DExt]
      symbols: []
      libs: [physics_null]
      frameworks: []
      linkFlags: []
  x86_64-ios:
    context:
      excludeLibs: [physics, LinearMath, BulletDynamics, BulletCollision, Box2D, script_box2d]
      excludeSymbols: [ScriptBox2DExt]
      symbols: []
      libs: [physics_null]
      frameworks: []
      linkFlags: []
  armv7-android:
    context:
      excludeLibs: [physics, LinearMath, BulletDynamics, BulletCollision, Box2D, script_box2d]
      excludeJars: []
      excludeSymbols: [ScriptBox2DExt]
      symbols: []
      libs: [physics_null]
      linkFlags: []
      jetifier: true
  arm64-android:
    context:
      excludeLibs: [physics, LinearMath, BulletDynamics, BulletCollision, Box2D, script_box2d]
      excludeJars: []
      excludeSymbols: [ScriptBox2DExt]
      symbols: []
      libs: [physics_null]
      linkFlags: []
      jetifier: true
  arm64-osx:
    context:
      excludeLibs: [physics, LinearMath, BulletDynamics, BulletCollision, Box2D, script_box2d]
      excludeSymbols: [ScriptBox2DExt]
      symbols: []
      libs: [physics_null]
      frameworks: []
      linkFlags: []
  x86_64-osx:
    context:
      excludeLibs: [physics, LinearMath, BulletDynamics, BulletCollision, Box2D, script_box2d]
      excludeSymbols: [ScriptBox2DExt]
      symbols: []
      libs: [physics_null]
      frameworks: []
      linkFlags: []
  x86_64-linux:
    context:
      excludeLibs: [physics, LinearMath, BulletDynamics, BulletCollision, Box2D, script_box2d]
      excludeSymbols: [ScriptBox2DExt]
      symbols: []
      libs: [physics_null]
      linkFlags: []
  x86-win32:
    context:
      excludeLibs: [libphysics, libLinearMath, libBulletDynamics, libBulletCollision, libBox2D, script_box2d]
      excludeSymbols: [ScriptBox2DExt]
      symbols: []
      libs: [libphysics_null.lib]
      linkFlags: []
  x86_64-win32:
    context:
      excludeLibs: [libphysics, libLinearMath, libBulletDynamics, libBulletCollision, libBox2D, script_box2d]
      excludeSymbols: [ScriptBox2DExt]
      symbols: []
      libs: [libphysics_null.lib]
      linkFlags: []
  js-web:
    context:
      excludeLibs: [physics, LinearMath, BulletDynamics, BulletCollision, Box2D, script_box2d]
      excludeJsLibs: []
      excludeSymbols: [ScriptBox2DExt]
      symbols: []
      libs: [physics_null]
      linkFlags: []
  wasm-web:
    context:
      excludeLibs: [physics, LinearMath, BulletDynamics, BulletCollision, Box2D, script_box2d]
      excludeJsLibs: []
      excludeSymbols: [ScriptBox2DExt]
      symbols: []
      libs: [physics_null]
      linkFlags: []
  arm64-nx64:
    context:
      excludeLibs: [physics, LinearMath, BulletDynamics, BulletCollision, Box2D, script_box2d]
      excludeJsLibs: []
      excludeSymbols: [ScriptBox2DExt]
      symbols: []
      libs: [physics_null]
      linkFlags: []