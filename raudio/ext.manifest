name: "LevinPlayer"

platforms:

  common:
    context:
      defines: ["SUPPORT_FILEFORMAT_XM", "SUPPORT_FILEFORMAT_MOD"]
  
  x86_64-osx:
    context:
      linkFlags:  ["-ObjC"]      

  arm64-ios:
    context:
      frameworks: ["AVFoundation"]
      linkFlags:  ["-ObjC"]

  armv7-ios:
    context:
      frameworks: ["AVFoundation"]
      linkFlags:  ["-ObjC"]