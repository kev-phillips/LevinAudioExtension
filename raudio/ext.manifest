name: "LevinPlayer"

platforms:

  common:
    context:
      defines: ["SUPPORT_FILEFORMAT_XM", "SUPPORT_FILEFORMAT_MOD"]
  
  armv7-ios:
    context:
      excludeLibs: [physics, LinearMath, BulletDynamics, BulletCollision, Box2D, script_box2d]
      excludeSymbols: [ScriptBox2DExt]
      symbols: []
      libs: [physics_null]
      frameworks: []
      linkFlags: []
  arm64-ios:
    context:
      excludeLibs: [physics, LinearMath, BulletDynamics, BulletCollision, Box2D, script_box2d]
      excludeSymbols: [ScriptBox2DExt]
      symbols: []
      libs: [physics_null]
      frameworks: []
      linkFlags: []
  x86_64-ios:
    context:
      excludeLibs: [physics, LinearMath, BulletDynamics, BulletCollision, Box2D, script_box2d]
      excludeSymbols: [ScriptBox2DExt]
      symbols: []
      libs: [physics_null]
      frameworks: []
      linkFlags: []
  armv7-android:
    context:
      excludeLibs: [physics, LinearMath, BulletDynamics, BulletCollision, Box2D, script_box2d]
      excludeJars: []
      excludeSymbols: [ScriptBox2DExt]
      symbols: []
      libs: [physics_null]
      linkFlags: []
      jetifier: true
  arm64-android:
