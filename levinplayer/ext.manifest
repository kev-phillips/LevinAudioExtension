name: "LevinPlayer"

platforms:

  common:
    context:
      # Defold already supplies the platform-appropriate visibility flags.
      # Custom LTO causes the DM_DECLARE_EXTENSION entry point to be dropped by
      # the LLVM 20 Windows toolchain used by Defold 1.13.0.
      flags : ["-O2"]
      # miniaudio backends are chosen per platform below. Platform defines
      # add to these; they can't remove one, so no backend switches here.
      defines: [
                  "SUPPORT_FILEFORMAT_XM",
                  "SUPPORT_FILEFORMAT_MOD"
                ]
  
  armv7-ios:
    context:
      excludeLibs: []
      excludeSymbols: []
      symbols: []
      libs: []
      frameworks: []
      linkFlags: []
  arm64-ios:
    context:
      excludeLibs: []
      excludeSymbols: []
      symbols: []
      libs: []
      frameworks: []
      linkFlags: []
  x86_64-ios:
    context:
      excludeLibs: []
      excludeSymbols: []
      symbols: []
      libs: []
      frameworks: []
      linkFlags: []
  armv7-android:
    context:
      excludeLibs: []
      excludeJars: []
      excludeSymbols: []
      symbols: []
      libs: []
      linkFlags: []
      jetifier: true
  arm64-android:
    context:
      excludeLibs: []
      excludeJars: []
      excludeSymbols: []
      symbols: []
      libs: []
      linkFlags: []
      jetifier: true
  arm64-osx:
    context:
      excludeLibs: []
      excludeSymbols: []
      symbols: []
      libs: []
      frameworks: []
      linkFlags: []
  x86_64-osx:
    context:
      excludeLibs: []
      excludeSymbols: []
      symbols: []
      libs: []
      frameworks: []
      linkFlags: []
  # Linux: ALSA and PulseAudio (PipeWire answers as PulseAudio). miniaudio
  # loads them at runtime, so nothing extra to install at build time. Don't
  # list dl/pthread/m here: extension libs link statically, and a static
  # libm breaks the x86_64 link. The engine already links them dynamically.
  # JACK is switched off in raudio.cpp itself.
  x86_64-linux:
    context:
      defines: ["MA_NO_SNDIO", "MA_NO_AUDIO4", "MA_NO_OSS"]
      excludeLibs: []
      excludeSymbols: []
      symbols: []
      libs: []
      linkFlags: []
  arm64-linux:
    context:
      defines: ["MA_NO_SNDIO", "MA_NO_AUDIO4", "MA_NO_OSS"]
      excludeLibs: []
      excludeSymbols: []
      symbols: []
      libs: []
      linkFlags: []
  x86-win32:
    context:
      # WASAPI only, as before.
      defines: ["MA_NO_DSOUND", "MA_NO_WINMM"]
      excludeLibs: []
      excludeSymbols: []
      symbols: []
      libs: []
      linkFlags: []
  x86_64-win32:
    context:
      # WASAPI only, as before.
      defines: ["MA_NO_DSOUND", "MA_NO_WINMM"]
      excludeLibs: []
      excludeSymbols: []
      symbols: []
      libs: []
      linkFlags: []
  js-web:
    context:
      excludeLibs: []
      excludeJsLibs: []
      excludeSymbols: []
      symbols: []
      libs: []
      linkFlags: []
  wasm-web:
    context:
      excludeLibs: []
      excludeJsLibs: []
      excludeSymbols: []
      symbols: []
      libs: []
      linkFlags: []
  arm64-nx64:
    context:
      excludeLibs: []
      excludeJsLibs: []
      excludeSymbols: []
      symbols: []
      libs: []
      linkFlags: []
