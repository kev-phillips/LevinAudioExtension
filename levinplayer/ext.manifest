name: "LevinPlayer"

platforms:

  common:
    context:
      flags : ["-O2", "-flto"]
      symbols: ["LevinPlayer"]
      defines: [
                  "SUPPORT_FILEFORMAT_XM", 
                  "SUPPORT_FILEFORMAT_MOD",
                  "MA_NO_DSOUND",
                  "MA_NO_WINMM",
                  "MA_NO_ALSA",
                  "MA_NO_PULSEAUDIO",
                  "MA_NO_JACK",
                  "MA_NO_SNDIO",
                  "MA_NO_AUDIO4",
                  "MA_NO_OSS"
                ]
  
  armv7-ios:
    context:
      excludeLibs: []
      excludeSymbols: []
      symbols: []
      libs: []
      frameworks: []
      linkFlags: []
  arm64-ios:
    context:
      excludeLibs: []
      excludeSymbols: []
      symbols: []
      libs: []
      frameworks: []
      linkFlags: []
  x86_64-ios:
