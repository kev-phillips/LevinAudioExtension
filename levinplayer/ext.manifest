name: "LevinPlayer"

platforms:

  common:
    context:
      # Defold already supplies the platform-appropriate visibility flags.
      # Custom LTO causes the DM_DECLARE_EXTENSION entry point to be dropped by
      # the LLVM 20 Windows toolchain used by Defold 1.13.0.
      flags : ["-O2"]
      defines: [
                  "SUPPORT_FILEFORMAT_XM", 
                  "SUPPORT_FILEFORMAT_MOD",
                  "MA_NO_DSOUND",
                  "MA_NO_WINMM",
                  "MA_NO_ALSA",
                  "MA_NO_PULSEAUDIO",
                  "MA_NO_JACK",
                  "MA_NO_SNDIO",
                  "MA_NO_AUDIO4",
                  "MA_NO_OSS"
                ]
  
  armv7-ios:
    context:
      excludeLibs: []
      excludeSymbols: []
      symbols: []
      libs: []
      frameworks: []
      linkFlags: []
  arm64-ios:
    context:
      excludeLibs: []
      excludeSymbols: []
      symbols: []
      libs: []
      frameworks: []
      linkFlags: []
  x86_64-ios:
    context:
      excludeLibs: []
      excludeSymbols: []
      symbols: []
      libs: []
      frameworks: []
      linkFlags: []
  armv7-android:
    context:
      excludeLibs: []
      excludeJars: []
      excludeSymbols: []
      symbols: []
      libs: []
      linkFlags: []
      jetifier: true
  arm64-android:
    context:
      excludeLibs: []
      excludeJars: []
      excludeSymbols: []
      symbols: []
      libs: []
      linkFlags: []
      jetifier: true
  arm64-osx:
    context:
      excludeLibs: []
      excludeSymbols: []
      symbols: []
      libs: []
      frameworks: []
      linkFlags: []
  x86_64-osx:
    context:
      excludeLibs: []
      excludeSymbols: []
      symbols: []
      libs: []
      frameworks: []
      linkFlags: []
  x86_64-linux:
    context:
      excludeLibs: []
      excludeSymbols: []
      symbols: []
      libs: []
      linkFlags: []
  x86-win32:
    context:
      excludeLibs: []
      excludeSymbols: []
      symbols: []
      libs: []
      linkFlags: []
  x86_64-win32:
    context:
      excludeLibs: []
      excludeSymbols: []
      symbols: []
      libs: []
      linkFlags: []
  js-web:
    context:
      excludeLibs: []
      excludeJsLibs: []
      excludeSymbols: []
      symbols: []
      libs: []
      linkFlags: []
  wasm-web:
    context:
      excludeLibs: []
      excludeJsLibs: []
      excludeSymbols: []
      symbols: []
      libs: []
      linkFlags: []
  arm64-nx64:
    context:
      excludeLibs: []
      excludeJsLibs: []
      excludeSymbols: []
      symbols: []
      libs: []
      linkFlags: []
